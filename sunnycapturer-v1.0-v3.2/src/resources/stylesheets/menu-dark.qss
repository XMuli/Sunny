/*///////////////////////////////// Recording Menu //////////////////////////////*/

RecordingMenu {
    background-color: #232323;
}

RecordingMenu QCheckBox::indicator::hover {
    background-color: #323232;
}

RecordingMenu QCheckBox#mic-btn::indicator:unchecked {
    image: url(:/icons/microphone-light);
}

RecordingMenu QCheckBox#mic-btn::indicator:checked {
    image: url(:/icons/microphone-mute-light);
}

RecordingMenu QCheckBox#mic-btn::indicator:disabled {
    image: url(:/icons/microphone-mute-dark);
}

RecordingMenu QCheckBox#speaker-btn::indicator:unchecked {
    image: url(:/icons/speaker-light);
}

RecordingMenu QCheckBox#speaker-btn::indicator:checked {
    image: url(:/icons/speaker-mute-light);
}

RecordingMenu QCheckBox#speaker-btn::indicator:disabled {
    image: url(:/icons/speaker-mute-dark);
}

RecordingMenu QCheckBox#camera-btn::indicator:checked {
    image: url(:/icons/camera-fill-light);
}

RecordingMenu QCheckBox#camera-btn::indicator:unchecked {
    image: url(:/icons/camera-light);
}

RecordingMenu QCheckBox#camera-btn::indicator:disabled {
    image: url(:/icons/camera-dark);
}

RecordingMenu QLabel#time {
    color: #e6e6e6;
}

RecordingMenu QCheckBox#pause-btn::indicator:unchecked {
    image: url(:/icons/pause-light);
}

RecordingMenu QCheckBox#pause-btn::indicator:checked {
    image: url(:/icons/play-light);
}

/*///////////////////////////////// Editing Menu //////////////////////////////*/

EditingMenu, EditingSubmenu {
    background-color: #232323;
}

EditingMenu QCheckBox::indicator:unchecked:hover {
    background-color: #323232;
}

EditingMenu QCheckBox#rect-btn::indicator {
    image: url(:/icons/menu_bar/rectangle_light);
}

EditingMenu QCheckBox#ellipse-btn::indicator {
    image: url(:/icons/menu_bar/circle_light);
}

EditingMenu QCheckBox#arrow-btn::indicator {
    image: url(:/icons/menu_bar/arrow_light);
}

EditingMenu QCheckBox#line-btn::indicator {
    image: url(:/icons/menu_bar/line_light);
}

EditingMenu QCheckBox#pencil-btn::indicator {
    image: url(:/icons/menu_bar/pencil_light);
}

EditingMenu QCheckBox#image-btn::indicator {
    image: url(:/icons/menu_bar/image_light);
}

EditingMenu QCheckBox#counter-btn::indicator {
    image: url(:/icons/menu_bar/counter_light);
}

EditingMenu QCheckBox#text-btn::indicator {
    image: url(:/icons/menu_bar/text_light);
}

EditingMenu QCheckBox#eraser-btn::indicator {
    image: url(:/icons/menu_bar/eraser_light);
}

EditingMenu QCheckBox#mosaic-btn::indicator {
    image: url(:/icons/menu_bar/mosaic_light);
}

EditingMenu QCheckBox#translate-btn::indicator {
    image: url(:/icons/menu_bar/translate_light);
}

EditingMenu QCheckBox#extract_text-btn::indicator {
    image: url(:/icons/menu_bar/extract_text_light);
}

EditingMenu QCheckBox#scroll-btn::indicator {
    image: url(:/icons/menu_bar/scroll_capture_light);
}

EditingMenu QCheckBox#undo-btn::indicator {
    image: url(:/icons/menu_bar/undo_light);
}

EditingMenu QCheckBox#redo-btn::indicator {
    image: url(:/icons/menu_bar/redo_light);
}

EditingMenu QCheckBox#undo-btn::indicator:disabled {
    image: url(:/icons/menu_bar/undo_dark);
    background-color: #434343;
}

EditingMenu QCheckBox#redo-btn::indicator:disabled {
    image: url(:/icons/menu_bar/redo_dark);
    background-color: #434343;
}

EditingMenu QCheckBox#pin-btn::indicator {
    image: url(:/icons/menu_bar/pin_light);
}

EditingMenu QCheckBox#save-btn::indicator {
    image: url(:/icons/menu_bar/save_light);
}

EditingMenu QCheckBox#close-btn::indicator {
    image: url(:/icons/menu_bar/close_light);
}

EditingMenu QCheckBox#ok-btn::indicator {
    image: url(:/icons/menu_bar/copy_light);
}

/*///////////////////////////////// Editing Submenu //////////////////////////////*/

EditingMenu QCheckBox::indicator:unchecked:hover {
    background-color: #323232;
}

EditingMenu WidthButton {
    color: #e6e6e6;
}

EditingMenu WidthButton:unchecked:hover {
    background-color: #323232;
}

EditingSubmenu QCheckBox#fill_btn::indicator {
    image: url(:/icons/submenu_bar/rectangle_fill_light)
}

EditingSubmenu QCheckBox#arrow_simple::indicator {
    image: url(:/icons/submenu_bar/arrow_light)
}

EditingSubmenu QCheckBox#arrow_hollow::indicator {
    image: url(:/icons/submenu_bar/arrow_bloken_light)
}

EditingSubmenu QCheckBox#arrow_line::indicator {
    image: url(:/icons/submenu_bar/line_light)
}

EditingSubmenu QCheckBox#blur_smooth::indicator {
    image: url(:/icons/submenu_bar/blur_smooth_light)
}

EditingSubmenu QCheckBox#blur_mosaic::indicator {
    image: url(:/icons/submenu_bar/blur_mosaic_light)
}

EditingSubmenu QCheckBox#counter_letter::indicator {
    image: url(:/icons/submenu_bar/counter_letter_light)
}

EditingSubmenu QCheckBox#counter_number::indicator {
    image: url(:/icons/submenu_bar/counter_number_light)
}

/* text */
EditingSubmenu QCheckBox#text_bold::indicator {
    image: url(:/icons/submenu_bar/text_bold_light)
}

EditingSubmenu QCheckBox#text_italic::indicator {
    image: url(:/icons/submenu_bar/text_italic_light)
}

EditingSubmenu QCheckBox#text_outline::indicator {
    image: url(:/icons/submenu_bar/text_outline_light)
}

EditingSubmenu QCheckBox#text_underline::indicator {
    image: url(:/icons/submenu_bar/text_underline_light)
}

EditingSubmenu QCheckBox#text_strikeout::indicator {
    image: url(:/icons/submenu_bar/text_strikeout_light)
}

